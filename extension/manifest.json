{
  "manifest_version": 3,
  "name": "Vidsnap: Video Downloader",
  "version": "0.2.1",
  "description": "Download videos from any site in the resolution you want, as MP4 or MP3.",
  "key": "",
  "permissions": ["nativeMessaging", "cookies", "webRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Vidsnap" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
