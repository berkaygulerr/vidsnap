{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidsnap",
  "version": "0.2.0",
  "identifier": "com.vidsnap.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "cargo build --release --manifest-path ../host/Cargo.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vidsnap",
        "width": 480,
        "height": 640,
        "minWidth": 400,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../host/target/release/vidsnap-host.exe": "vidsnap-host.exe",
      "../../../extension/": "extension/",
      "resources/install-extension.ps1": "install-extension.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExM0E1OTgzMDU2MkI3MTEKUldRUnQySUZnMWs2b1lNVTNzYXAralQ0akc5TzdJMlVkZmNTU283MlA0NHhIdVl2U2d3NEp1UHQK",
      "endpoints": [
        "https://github.com/berkaygulerr/vidsnap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
